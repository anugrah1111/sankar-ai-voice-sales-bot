# Local AI provider. Ollama does not require an API key.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=15000

# Optional hosted provider. Set AI_PROVIDER=openai to use it instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Local data is stored here by default. Mount a persistent disk at this path in production.
DATA_DIR=./data
PORT=3001
NODE_ENV=development

# Optional comma-separated browser origins. The same-origin production setup needs no extra value.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep individual uploaded audio chunks bounded.
MAX_RECORDING_CHUNK_BYTES=12582912
